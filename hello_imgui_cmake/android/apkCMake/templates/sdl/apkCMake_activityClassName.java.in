package com.cloudberrypine.PolyPine;

/**
* A sample wrapper class that just calls SDLActivity
*/
import android.os.Bundle;
import android.os.Handler;
import android.os.Looper;

import org.libsdl.app.SDLActivity;

import android.app.Activity;
import android.content.Context;
import android.util.Log;

import androidx.annotation.NonNull;
import androidx.annotation.Nullable;

import com.android.billingclient.api.AcknowledgePurchaseParams;
import com.android.billingclient.api.BillingClient;
import com.android.billingclient.api.BillingClientStateListener;
import com.android.billingclient.api.BillingFlowParams;
import com.android.billingclient.api.BillingResult;
import com.android.billingclient.api.PendingPurchasesParams;
import com.android.billingclient.api.Purchase;
import com.android.billingclient.api.PurchasesUpdatedListener;
import com.android.billingclient.api.QueryProductDetailsParams;
import com.android.billingclient.api.ProductDetails;
import com.android.billingclient.api.ProductDetailsResponseListener;
import com.android.billingclient.api.QueryProductDetailsResult;
import com.android.billingclient.api.QueryPurchasesParams;

import java.util.ArrayList;
import java.util.List;
import java.util.Set;
import java.util.concurrent.ConcurrentHashMap;
import java.util.concurrent.atomic.AtomicBoolean;
import java.util.concurrent.atomic.AtomicReference;


public class PolyPine extends SDLActivity
{
    public class BillingManager implements PurchasesUpdatedListener {
         private static final String TAG = "BillingManager";
         private final BillingClient billingClient;
         private final Activity activity;
         private final AtomicBoolean isFullGameUnlocked = new AtomicBoolean(false);
         private final AtomicReference<String> localizedFullGamePrice = new AtomicReference<>("");
         private final AtomicReference<String> fullGamePurchaseErrorMessage = new AtomicReference<>("");
         private final AtomicBoolean isPurchasingFullGame = new AtomicBoolean(false);
         // volatile so that ensureProductDetailsLoaded() (called from onResume on
         // the main thread) sees the latest value written from the billing
         // library's response thread without an explicit memory barrier.
         private volatile ProductDetails fullGameProductDetails;
         private volatile ProductDetails.OneTimePurchaseOfferDetails fullGameOfferDetails;
         // Coalesces concurrent queryProductDetails() calls (e.g. onBillingSetupFinished
         // and onResume->ensureProductDetailsLoaded firing in quick succession) into a
         // single in-flight async request. Without this we'd fire two parallel queries
         // and process two duplicate callbacks.
         private final AtomicBoolean productDetailsQueryInFlight = new AtomicBoolean(false);
         private static final String FULL_GAME_PRODUCT_ID = "com.cloudberrypine.polypine_full_game";
         // Tokens we've already started acknowledging — prevents duplicate
         // acknowledgePurchase() calls when both onPurchasesUpdated and
         // onResume->queryPurchases see the same purchase before the server has
         // marked it as acknowledged (which would result in a "Server error,
         // please try again" log line on the second call).
         private final Set<String> acknowledgingTokens = ConcurrentHashMap.newKeySet();
         // Retry plumbing for transient billing failures (e.g. cold Play Services
         // after a phone reboot, network blips). enableAutoServiceReconnection()
         // only handles disconnection of an already-connected service — it does
         // not retry an initial setup failure or a queryProductDetails that
         // returned non-OK / empty. Without these retries, the app stays in a
         // "Product not found" state until next launch.
         private final Handler retryHandler = new Handler(Looper.getMainLooper());
         private static final long INITIAL_RETRY_DELAY_MS = 2000L;
         private static final long MAX_RETRY_DELAY_MS = 60000L;
         private volatile long setupRetryDelayMs = INITIAL_RETRY_DELAY_MS;
         private volatile long productDetailsRetryDelayMs = INITIAL_RETRY_DELAY_MS;
         private volatile boolean productDetailsRetryScheduled = false;
         // Reference to the currently-scheduled setup retry (if any) so we can
         // cancel it if setup succeeds via a different path before it fires —
         // notably BillingClient's own internal retry (which we observe in
         // practice even though enableAutoServiceReconnection() docs only mention
         // disconnects). Without cancellation we get duplicate startConnection +
         // setup-finished + queryProductDetails calls 2s apart.
         private Runnable pendingSetupRetry = null;
         private final BillingClientStateListener billingClientStateListener = new BillingClientStateListener() {
             @Override
             public void onBillingSetupFinished(@NonNull BillingResult billingResult) {
                 // Cancel any pending retry — this callback is the authoritative
                 // result of the most recent connection attempt (success or
                 // failure). On failure we'll schedule a new retry below; on
                 // success we just forget about the stale pending one.
                 if (pendingSetupRetry != null) {
                     retryHandler.removeCallbacks(pendingSetupRetry);
                     pendingSetupRetry = null;
                 }
                 if (billingResult.getResponseCode() == BillingClient.BillingResponseCode.OK) {
                     Log.d(TAG, "Billing client setup finished.");
                     setupRetryDelayMs = INITIAL_RETRY_DELAY_MS; // reset backoff for next time
                     queryProductDetails();
                     queryPurchases();
                 } else {
                     final long delay = setupRetryDelayMs;
                     Log.e(TAG, "Billing client setup failed with response code: " + billingResult.getResponseCode()
                             + ". Retrying in " + delay + "ms.");
                     setupRetryDelayMs = Math.min(delay * 2, MAX_RETRY_DELAY_MS);
                     pendingSetupRetry = () -> {
                         pendingSetupRetry = null;
                         billingClient.startConnection(billingClientStateListener);
                     };
                     retryHandler.postDelayed(pendingSetupRetry, delay);
                 }
             }

             @Override
             public void onBillingServiceDisconnected() {
                 // BillingClient was built with enableAutoServiceReconnection(); it
                 // handles reconnection of a previously-connected service on its
                 // own and re-fires onBillingSetupFinished on success.
                 Log.d(TAG, "Billing service disconnected. Auto-reconnect will retry.");
             }
         };

         public BillingManager(Activity activity, Context context) {
             this.activity = activity;
             billingClient = BillingClient.newBuilder(context)
                     .setListener(this)
                     .enablePendingPurchases(
                             PendingPurchasesParams.newBuilder()
                                     .enableOneTimeProducts()
                                     .build()
                     )
                     .enableAutoServiceReconnection()
                     .build();
             connectToGooglePlay();
         }

         void connectToGooglePlay() {
             // billingClientStateListener handles success, retries on initial-setup
             // failure (with exponential backoff), and relies on
             // enableAutoServiceReconnection() for disconnects.
             billingClient.startConnection(billingClientStateListener);
         }

         void queryProductDetails() {
             // Coalesce concurrent callers — only one async query in flight at a time.
             // Without this, onBillingSetupFinished and onResume->ensureProductDetailsLoaded
             // racing each other produce two parallel queries and two duplicate
             // "Received N one-time purchase offer(s)" callbacks.
             if (!productDetailsQueryInFlight.compareAndSet(false, true)) {
                 Log.d(TAG, "queryProductDetails skipped: query already in flight.");
                 return;
             }
             List<QueryProductDetailsParams.Product> productList = new ArrayList<>();
             productList.add(
                     QueryProductDetailsParams.Product.newBuilder()
                             .setProductId(FULL_GAME_PRODUCT_ID)
                             .setProductType(BillingClient.ProductType.INAPP)
                             .build()
             );
             QueryProductDetailsParams params = QueryProductDetailsParams.newBuilder()
                     .setProductList(productList)
                     .build();

             billingClient.queryProductDetailsAsync(params, new ProductDetailsResponseListener() {
                 @Override
                 public void onProductDetailsResponse(@NonNull BillingResult billingResult, @NonNull QueryProductDetailsResult productDetailsResult) {
                     // Always release the in-flight flag, even on failure paths.
                     productDetailsQueryInFlight.set(false);
                     List<ProductDetails> productDetailsList = productDetailsResult.getProductDetailsList();
                     boolean success = billingResult.getResponseCode() == BillingClient.BillingResponseCode.OK
                             && !productDetailsList.isEmpty();
                     if (success) {
                         productDetailsRetryDelayMs = INITIAL_RETRY_DELAY_MS; // reset backoff on success
                         fullGameProductDetails = productDetailsList.get(0);
                         List<ProductDetails.OneTimePurchaseOfferDetails> offerDetailsList = fullGameProductDetails.getOneTimePurchaseOfferDetailsList();
                         if (offerDetailsList != null && !offerDetailsList.isEmpty()) {
                             Log.i(TAG, "Received " + offerDetailsList.size() + " one-time purchase offer(s) for full game.");
                             fullGameOfferDetails = offerDetailsList.get(0);
                             for (int i = 0; i < offerDetailsList.size(); i++) {
                                 ProductDetails.OneTimePurchaseOfferDetails offer = offerDetailsList.get(i);
                                 Log.i(TAG, "  Offer[" + i + "] priceMicros=" + offer.getPriceAmountMicros()
                                         + " formatted=" + offer.getFormattedPrice()
                                         + " token=" + offer.getOfferToken());
                                 if (offer.getPriceAmountMicros() < fullGameOfferDetails.getPriceAmountMicros()) {
                                     fullGameOfferDetails = offer;
                                 }
                             }
                             Log.i(TAG, "Selected offer: priceMicros=" + fullGameOfferDetails.getPriceAmountMicros()
                                     + " token=" + fullGameOfferDetails.getOfferToken());
                             localizedFullGamePrice.set(fullGameOfferDetails.getFormattedPrice());
                         } else {
                             // Got OK + a product entry but no offers — treat as failure so
                             // we retry; otherwise we'd permanently have product details
                             // but no offer to launch the flow with.
                             scheduleProductDetailsRetry("OK response but offer list empty");
                         }
                     } else {
                         scheduleProductDetailsRetry("response code=" + billingResult.getResponseCode()
                                 + " productDetailsList.size=" + productDetailsList.size());
                     }
                 }
             });
         }

         private void scheduleProductDetailsRetry(String reasonForLog) {
             // Coalesce concurrent failures so we only have one retry scheduled at a time.
             if (productDetailsRetryScheduled) {
                 return;
             }
             productDetailsRetryScheduled = true;
             final long delay = productDetailsRetryDelayMs;
             Log.e(TAG, "queryProductDetails failed (" + reasonForLog + "). Retrying in " + delay + "ms.");
             productDetailsRetryDelayMs = Math.min(delay * 2, MAX_RETRY_DELAY_MS);
             retryHandler.postDelayed(() -> {
                 productDetailsRetryScheduled = false;
                 if (fullGameProductDetails == null || fullGameOfferDetails == null) {
                     queryProductDetails();
                 }
             }, delay);
         }

         /**
          * Re-runs queryProductDetails() if details haven't loaded yet. Safe to call
          * any number of times — does nothing if details are already populated.
          * Intended for onResume() to recover from cases where the initial query
          * happened during a Play Services warmup window and silently returned empty.
          */
         public void ensureProductDetailsLoaded() {
             if (fullGameProductDetails == null || fullGameOfferDetails == null) {
                 // Reset backoff so a fresh user-visible attempt isn't penalized by
                 // the previous failure history.
                 productDetailsRetryDelayMs = INITIAL_RETRY_DELAY_MS;
                 queryProductDetails();
             }
         }

         void queryPurchases() {
             billingClient.queryPurchasesAsync(
                     QueryPurchasesParams.newBuilder().setProductType(BillingClient.ProductType.INAPP).build(),
                     (billingResult, purchases) -> {
                         boolean wasRestoring = isPurchasingFullGame.getAndSet(false);
                         if (billingResult.getResponseCode() == BillingClient.BillingResponseCode.OK) {
                             boolean foundFullGame = false;
                             for (Purchase purchase : purchases) {
                                 if (purchase.getProducts().contains(FULL_GAME_PRODUCT_ID) && purchase.getPurchaseState() == Purchase.PurchaseState.PURCHASED) {
                                     foundFullGame = true;
                                     handlePurchase(purchase);
                                 }
                             }
                             if (!foundFullGame && isFullGameUnlocked.get()) {
                                 Log.i(TAG, "Full game entitlement no longer present; revoking (likely Play Pass lapse).");
                                 isFullGameUnlocked.set(false);
                                 setIsGameUnlockedToFalse();
                             }
                             if (wasRestoring && !foundFullGame) {
                                 fullGamePurchaseErrorMessage.set("No previous purchase found on this account.");
                             }
                         } else if (wasRestoring) {
                             fullGamePurchaseErrorMessage.set("Could not contact Google Play (code " + billingResult.getResponseCode() + ").");
                             Log.e(TAG, "queryPurchases failed: " + billingResult.getDebugMessage());
                         }
                     }
             );
         }

         public void purchaseUnlockFullGame() {
             Log.i(TAG, "purchaseUnlockFullGame() called. isFullGameUnlocked=" + isFullGameUnlocked.get()
                     + " isPurchasingFullGame=" + isPurchasingFullGame.get());
             if (fullGameProductDetails != null && fullGameOfferDetails != null) {
                 isPurchasingFullGame.set(true);
                 fullGamePurchaseErrorMessage.set("");
                 List<BillingFlowParams.ProductDetailsParams> productDetailsParamsList = new ArrayList<>();
                 productDetailsParamsList.add(
                         BillingFlowParams.ProductDetailsParams.newBuilder()
                                 .setProductDetails(fullGameProductDetails)
                                 .setOfferToken(fullGameOfferDetails.getOfferToken())
                                 .build()
                 );
                 BillingFlowParams billingFlowParams = BillingFlowParams.newBuilder()
                         .setProductDetailsParamsList(productDetailsParamsList)
                         .build();
                 Log.i(TAG, "About to call launchBillingFlow().");
                 BillingResult flowResult = billingClient.launchBillingFlow(activity, billingFlowParams);
                 Log.i(TAG, "launchBillingFlow() returned code=" + flowResult.getResponseCode()
                         + " debug=" + flowResult.getDebugMessage());
             } else {
                 fullGamePurchaseErrorMessage.set("Product not found.");
                 Log.e(TAG, "Cannot initiate purchase, product details not loaded.");
             }
         }

         public void restoreUnlockFullGamePurchase() {
             isPurchasingFullGame.set(true);
             fullGamePurchaseErrorMessage.set("");
             queryPurchases();
         }

         @Override
         public void onPurchasesUpdated(@NonNull BillingResult billingResult, @Nullable List<Purchase> purchases) {
             isPurchasingFullGame.set(false);
             if (billingResult.getResponseCode() == BillingClient.BillingResponseCode.OK && purchases != null) {
                 for (Purchase purchase : purchases) {
                     handlePurchase(purchase);
                 }
             } else if (billingResult.getResponseCode() == BillingClient.BillingResponseCode.USER_CANCELED) {
                 Log.d(TAG, "User canceled the purchase.");
             } else if (billingResult.getResponseCode() == BillingClient.BillingResponseCode.ITEM_ALREADY_OWNED) {
                 isFullGameUnlocked.set(true);
                 setIsGameUnlockedToTrue();
             } else {
                 fullGamePurchaseErrorMessage.set("Error: " + billingResult.getDebugMessage());
                 Log.e(TAG, "Purchase failed with error: " + billingResult.getDebugMessage());
             }
         }

         private void handlePurchase(Purchase purchase) {
             if (purchase.getPurchaseState() == Purchase.PurchaseState.PURCHASED) {
                 // Grant entitlement immediately so the game UI updates the moment the
                 // purchase succeeds; otherwise the user can re-tap "Buy" before the
                 // acknowledge callback returns and Google Play will show an
                 // "already owned" sheet.
                 isFullGameUnlocked.set(true);
                 setIsGameUnlockedToTrue();
                 if (!purchase.isAcknowledged()) {
                     final String token = purchase.getPurchaseToken();
                     // Only fire acknowledgePurchase once per token. onPurchasesUpdated
                     // and queryPurchases (called from onResume) can both observe the
                     // same purchase before its acknowledged-bit flips on Google's
                     // server, so without this guard we'd send two acknowledge
                     // requests and the second would fail with a server error.
                     if (!acknowledgingTokens.add(token)) {
                         Log.d(TAG, "Acknowledge already in flight for purchase token; skipping.");
                         return;
                     }
                     AcknowledgePurchaseParams acknowledgePurchaseParams =
                             AcknowledgePurchaseParams.newBuilder()
                                     .setPurchaseToken(token)
                                     .build();
                     billingClient.acknowledgePurchase(acknowledgePurchaseParams, billingResult -> {
                         if (billingResult.getResponseCode() != BillingClient.BillingResponseCode.OK) {
                             Log.e(TAG, "Error acknowledging purchase: " + billingResult.getDebugMessage());
                             // Allow a future retry on a real failure.
                             acknowledgingTokens.remove(token);
                         }
                     });
                 }
             } else if (purchase.getPurchaseState() == Purchase.PurchaseState.PENDING) {
                 // Handle pending transactions if necessary
                 Log.d(TAG, "Purchase is pending.");
             }
         }

         public boolean isFullGameUnlocked() {
             return isFullGameUnlocked.get();
         }

         public boolean isPurchasingFullGame() {
             return isPurchasingFullGame.get();
         }

         public String getLocalizedFullGamePrice() {
             return localizedFullGamePrice.get();
         }

         public String getFullGamePurchaseErrorMessage() {
             return fullGamePurchaseErrorMessage.get();
         }
     }

    private BillingManager billingManager;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        billingManager = new BillingManager(this, getContext());
    }

    @Override
    protected void onResume() {
        super.onResume();
        if (billingManager != null) {
            billingManager.queryPurchases();
            // Recover from cases where the initial product-details query landed
            // during a Play Services warmup window and silently returned empty.
            billingManager.ensureProductDetailsLoaded();
        }
    }

    public void purchaseUnlockFullGame() {
        billingManager.purchaseUnlockFullGame();
    }

    public void restoreUnlockFullGamePurchase() {
        billingManager.restoreUnlockFullGamePurchase();
    }

    public boolean isFullGameUnlocked() {
        return billingManager.isFullGameUnlocked();
    }

    public boolean isPurchasingFullGame() {
        return billingManager.isPurchasingFullGame();
    }

    public String getLocalizedFullGamePrice() {
        return billingManager.getLocalizedFullGamePrice();
    }

    public String getFullGamePurchaseErrorMessage() {
        return billingManager.getFullGamePurchaseErrorMessage();
    }

    /**
     * Called from native code when the user presses the Android system back
     * button on the root main menu. Per Google Play guidelines, this must
     * either exit the app or prompt the user to confirm exit.
     *
     * Routed through runOnUiThread because the JNI call originates on SDL's
     * main thread, not the Android UI thread, and finish() must run on the
     * UI thread.
     *
     * We follow finish() with System.exit(0) because the hello_imgui runner
     * is built with HELLOIMGUI_CANNOTQUIT on Android, meaning the SDL game
     * loop on its own thread never returns. Without killing the process,
     * the activity is destroyed but the wedged SDL thread keeps the process
     * alive — and Android then reuses the half-dead process on next launch,
     * leaving the user stuck on the splash screen with no logs.
     */
    public void exitApp() {
        runOnUiThread(() -> {
            finish();
            System.exit(0);
        });
    }

    /**
     * This method is called by SDL before loading the native shared libraries.
     * It can be overridden to provide names of shared libraries to be loaded.
     * The default implementation returns the defaults. It never returns null.
     * An array returned by a new implementation must at least contain "SDL2".
     * Also keep in mind that the order the libraries are loaded may matter.
     * @return names of shared libraries to be loaded (e.g. "SDL2", "main").
     */
    protected String[] getLibraries() {
        return new String[] {
            // "hidapi",
            "SDL2",
            // "SDL2_image",
            // "SDL2_mixer",
            // "SDL2_net",
            // "SDL2_ttf",
            "PolyPine"
        };
    }

    public static native void setIsGameUnlockedToTrue();
    public static native void setIsGameUnlockedToFalse();
}

